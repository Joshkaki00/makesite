<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <title>{{.Title}}</title>
  <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
</head>
<body class="bg-[#0c1b22]">
  <main class="mx-auto max-w-2xl px-4 py-12">
    <h1 class="text-3xl font-bold text-center text-[#c9922e] border-b border-[#c9922e]/30 pb-3">⚓ {{.Title}}</h1>
    <div class="mt-4 text-[#f0eadd] whitespace-pre-line prose prose-invert">{{.Body}}</div>
  </main>
</body>
</html>